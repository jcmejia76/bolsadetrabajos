// Prisma schema — Bolsa de Trabajos
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================= ENUMS =========================

enum Role {
  ADMINISTRADOR
  EMPRESA
  CANDIDATO
}

enum CompanyStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  SUSPENDIDA
}

enum JobStatus {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  RECHAZADA
  CAMBIOS_SOLICITADOS
  PUBLICADA
  CERRADA
  EXPIRADA
}

enum JobModalidad {
  PRESENCIAL
  REMOTO
  HIBRIDO
}

enum JobJornada {
  TIEMPO_COMPLETO
  MEDIO_TIEMPO
  TEMPORAL
  FREELANCE
  PASANTIA
}

enum ExperienceLevel {
  SIN_EXPERIENCIA
  JUNIOR
  SEMI_SENIOR
  SENIOR
  GERENCIAL
  DIRECTIVO
}

enum AcademicLevel {
  SECUNDARIA
  TECNICO
  UNIVERSITARIO_EN_CURSO
  UNIVERSITARIO_GRADUADO
  POSTGRADO
  MAESTRIA
  DOCTORADO
}

enum LanguageLevel {
  BASICO
  INTERMEDIO
  AVANZADO
  NATIVO
}

enum ApplicationStatus {
  RECIBIDA
  EN_REVISION
  VISTA
  PRESELECCIONADO
  ENTREVISTA
  RECHAZADO
  CONTRATADO
}

enum CVStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  CAMBIOS_SOLICITADOS
}

enum CVSourceType {
  UPLOAD
  BUILDER
}

enum NotificationType {
  EMPRESA_APROBADA
  EMPRESA_RECHAZADA
  EMPRESA_SUSPENDIDA
  OFERTA_APROBADA
  OFERTA_RECHAZADA
  OFERTA_CAMBIOS_SOLICITADOS
  CV_APROBADO
  CV_RECHAZADO
  CV_CAMBIOS_SOLICITADOS
  NUEVA_POSTULACION
  ESTADO_POSTULACION_CAMBIADO
  STAFF_INVITADO
  STAFF_PERMISOS_ACTUALIZADOS
  STAFF_SUSPENDIDO
  GENERICA
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
  WHATSAPP
}

// ========================= STAFF / RBAC =========================

enum StaffScope {
  SISTEMA
  EMPRESA
}

enum StaffStatus {
  INVITADO
  ACTIVO
  SUSPENDIDO
  ELIMINADO
}

enum Permission {
  // ----- Ámbito SISTEMA -----
  SISTEMA_EMPRESAS_VER
  SISTEMA_EMPRESAS_CREAR
  SISTEMA_EMPRESAS_EDITAR
  SISTEMA_EMPRESAS_APROBAR
  SISTEMA_EMPRESAS_SUSPENDER
  SISTEMA_EMPRESAS_ELIMINAR

  SISTEMA_VACANTES_VER
  SISTEMA_VACANTES_APROBAR
  SISTEMA_VACANTES_RECHAZAR
  SISTEMA_VACANTES_EDITAR
  SISTEMA_VACANTES_DESTACAR
  SISTEMA_VACANTES_ELIMINAR

  SISTEMA_CANDIDATOS_VER
  SISTEMA_CANDIDATOS_APROBAR_CV
  SISTEMA_CANDIDATOS_SUSPENDER
  SISTEMA_CANDIDATOS_ELIMINAR

  SISTEMA_POSTULACIONES_VER
  SISTEMA_POSTULACIONES_GESTIONAR
  SISTEMA_POSTULACIONES_EXPORTAR

  SISTEMA_DASHBOARD_SOLO_LECTURA
  SISTEMA_DASHBOARD_COMPLETO

  SISTEMA_CONFIGURACION_VER
  SISTEMA_CONFIGURACION_EDITAR

  SISTEMA_REPORTES_VER
  SISTEMA_REPORTES_EXPORTAR

  SISTEMA_EQUIPO_VER
  SISTEMA_EQUIPO_CREAR
  SISTEMA_EQUIPO_EDITAR
  SISTEMA_EQUIPO_SUSPENDER
  SISTEMA_EQUIPO_ELIMINAR

  // ----- Ámbito EMPRESA -----
  EMPRESA_OFERTAS_VER
  EMPRESA_OFERTAS_CREAR
  EMPRESA_OFERTAS_EDITAR
  EMPRESA_OFERTAS_PUBLICAR
  EMPRESA_OFERTAS_PAUSAR
  EMPRESA_OFERTAS_ELIMINAR

  EMPRESA_POSTULACIONES_VER
  EMPRESA_POSTULACIONES_REVISAR
  EMPRESA_POSTULACIONES_CAMBIAR_ESTADO
  EMPRESA_POSTULACIONES_DESCARGAR_CV
  EMPRESA_POSTULACIONES_AGREGAR_NOTAS

  EMPRESA_PERFIL_EDITAR

  EMPRESA_EQUIPO_INVITAR
  EMPRESA_EQUIPO_EDITAR_PERMISOS
  EMPRESA_EQUIPO_ELIMINAR

  EMPRESA_ESTADISTICAS_VER
}

// ========================= IDENTITY =========================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company?
  candidate Candidate?

  notifications       Notification[]
  auditLogs           AuditLog[]        @relation("AuditActor")
  approvedCompanies   Company[]         @relation("CompanyApprovedBy")
  createdJobPostings  JobPosting[]      @relation("JobCreatedBy")
  approvedJobPostings JobPosting[]      @relation("JobApprovedBy")
  reviewedCVs         CV[]              @relation("CVReviewedBy")
  applicationNotes    ApplicationNote[]
  updatedSiteSettings SiteSettings[]    @relation("SiteSettingsUpdatedBy")
  staffAccount        StaffMember?      @relation("StaffAccount")
  invitedStaff        StaffMember[]     @relation("StaffInvitedBy")

  @@index([role])
}

// ========================= COMPANY =========================

model Company {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  slug         String  @unique
  logoUrl      String?
  /// Hex color for the initials avatar shown wherever no logo is set.
  color        String?
  /// 1-2 letter avatar initials derived from `name` at creation time.
  initials     String?
  description  String? @db.Text
  industry     String?
  size         String?
  website      String?
  email        String
  phone        String?
  address      String?
  city         String?
  country      String?
  socialLinks  Json?
  contactName  String?
  contactEmail String?
  contactPhone String?

  status          CompanyStatus @default(PENDIENTE)
  rejectionReason String?
  approvedById    String?
  approvedBy      User?         @relation("CompanyApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobPostings  JobPosting[]
  staffMembers StaffMember[] @relation("CompanyStaff")
  staffRoles   StaffRole[]

  @@index([status])
}

// ========================= CANDIDATE =========================

model Candidate {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName        String
  lastName         String
  photoUrl         String?
  phone            String?
  address          String?
  birthDate        DateTime?
  gender           String?
  nationality      String?
  aboutMe          String?   @db.Text
  profession       String?
  availability     String?
  salaryAspiration Decimal?  @db.Decimal(10, 2)
  portfolioUrl     String?
  socialLinks      Json?
  references       Json?
  skills           String[]
  isProfilePublic  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workExperiences WorkExperience[]
  educations      Education[]
  certifications  Certification[]
  languages       CandidateLanguage[]
  cvs             CV[]
  applications    Application[]
  favorites       Favorite[]

  @@index([profession])
}

model WorkExperience {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?   @db.Text

  @@index([candidateId])
}

model Education {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)

  @@index([candidateId])
}

model Certification {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  name          String
  issuer        String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  credentialUrl String?

  @@index([candidateId])
}

model CandidateLanguage {
  id          String        @id @default(cuid())
  candidateId String
  candidate   Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  language    String
  level       LanguageLevel

  @@index([candidateId])
}

// ========================= CV =========================

model CV {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  fileName      String
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  sourceType    CVSourceType @default(UPLOAD)
  version       Int          @default(1)
  isPrimary     Boolean      @default(false)

  status       CVStatus  @default(PENDIENTE)
  reviewReason String?
  reviewedById String?
  reviewedBy   User?     @relation("CVReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]

  @@index([candidateId])
  @@index([status])
}

// ========================= JOB POSTING =========================

model JobCategory {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  jobPostings JobPosting[]
}

model JobPosting {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title            String
  slug             String       @unique
  categoryId       String?
  category         JobCategory? @relation(fields: [categoryId], references: [id])
  professionalArea String?

  modalidad  JobModalidad
  jornada    JobJornada
  department String?
  city       String?
  country    String?
  /// Approximate coordinates derived from city/department at save time, for the public map view.
  lat        Float?
  lng        Float?

  salaryMin     Decimal? @db.Decimal(10, 2)
  salaryMax     Decimal? @db.Decimal(10, 2)
  salaryVisible Boolean  @default(false)

  description      String  @db.Text
  responsibilities String? @db.Text
  requirements     String? @db.Text
  benefits         String? @db.Text

  vacancies Int       @default(1)
  deadline  DateTime?

  experienceLevel    ExperienceLevel?
  academicLevel      AcademicLevel?
  requiresLicense    Boolean          @default(false)
  requiresOwnVehicle Boolean          @default(false)
  travelAvailability Boolean          @default(false)
  keywords           String[]

  status          JobStatus @default(BORRADOR)
  rejectionReason String?
  isFeatured      Boolean   @default(false)
  viewsCount      Int       @default(0)

  createdById  String
  createdBy    User    @relation("JobCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?   @relation("JobApprovedBy", fields: [approvedById], references: [id])

  publishedAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requiredLanguages JobRequiredLanguage[]
  applications      Application[]
  favorites         Favorite[]

  @@index([companyId])
  @@index([status])
  @@index([categoryId])
}

model JobRequiredLanguage {
  id           String        @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  language     String
  level        LanguageLevel

  @@index([jobPostingId])
}

// ========================= APPLICATION =========================

model Application {
  id           String     @id @default(cuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  candidateId  String
  candidate    Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  cvId         String
  cv           CV         @relation(fields: [cvId], references: [id])

  coverLetter String?           @db.Text
  status      ApplicationStatus @default(RECIBIDA)

  appliedAt       DateTime  @default(now())
  viewedAt        DateTime?
  statusUpdatedAt DateTime?
  updatedAt       DateTime  @updatedAt

  notes ApplicationNote[]

  @@unique([jobPostingId, candidateId])
  @@index([status])
  @@index([candidateId])
}

model ApplicationNote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  note          String      @db.Text
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

model Favorite {
  id           String     @id @default(cuid())
  candidateId  String
  candidate    Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([candidateId, jobPostingId])
  @@index([jobPostingId])
}

// ========================= NOTIFICATION =========================

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String
  message   String
  metadata  Json?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, isRead])
}

// ========================= AUDIT LOG =========================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// ========================= SITE SETTINGS =========================

model SiteSettings {
  id                 String   @id @default(cuid())
  maintenanceMode    Boolean  @default(false)
  maintenanceMessage String?  @db.Text
  updatedById        String?
  updatedBy          User?    @relation("SiteSettingsUpdatedBy", fields: [updatedById], references: [id])
  updatedAt          DateTime @updatedAt
}

// ========================= STAFF / RBAC =========================

model StaffRole {
  id              String     @id @default(cuid())
  scope           StaffScope
  companyId       String?
  company         Company?   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  isSystemDefault Boolean    @default(false)

  permissions StaffRolePermission[]
  members     StaffMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, companyId, name])
  @@index([scope, companyId])
}

model StaffRolePermission {
  id         String     @id @default(cuid())
  roleId     String
  role       StaffRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission

  @@unique([roleId, permission])
}

model StaffMember {
  id     String     @id @default(cuid())
  userId String     @unique
  user   User       @relation("StaffAccount", fields: [userId], references: [id], onDelete: Cascade)
  scope  StaffScope

  companyId String?
  company   Company? @relation("CompanyStaff", fields: [companyId], references: [id], onDelete: Cascade)

  roleId String
  role   StaffRole @relation(fields: [roleId], references: [id])

  status   StaffStatus @default(INVITADO)
  jobTitle String?

  invitedById         String
  invitedBy           User      @relation("StaffInvitedBy", fields: [invitedById], references: [id])
  invitationToken     String?   @unique
  invitationExpiresAt DateTime?
  acceptedAt          DateTime?

  lastLoginAt DateTime?
  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, companyId])
}
